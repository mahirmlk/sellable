# =============================================================================
# SELLABLE — environment configuration (backend / Commerce Core)
# Copy to `.env` and fill in real values. Never commit the populated `.env`.
#
# PRODUCTION-SAFE DEFAULTS: this file defaults to production posture.
# For local development ONLY, override explicitly in your own `.env`:
#   SELLABLE_ENVIRONMENT=development
#   CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Never copy development overrides to a production host: dev defaults plus the
# well-known demo key simultaneously enable the server simulation endpoints AND
# the demo UI affordances (see C-1 in plans/code-inspection-plan.md).
# =============================================================================

# Application
#   production (default, fail-closed) | development | test
#   Only development/test enable demo conveniences (demo agent key, webhook
#   simulation endpoints). An unset value also means production.
SELLABLE_ENVIRONMENT=production

# NOTE: the root API_BASE_URL key is retired and intentionally absent — the
# merchant console reads NEXT_PUBLIC_API_URL from
# apps/merchant-console/.env.local(.example). Point the console at this
# backend there, not here.

# HTTP bind (deploy knobs consumed by the process launcher, e.g.)
#     uvicorn sellable.main:app --host "${HOST:-0.0.0.0}" --port "${PORT:-8000}"
#   The Dockerfile listens on 8000; Railway injects PORT automatically.
HOST=0.0.0.0
PORT=8000

# CORS — REQUIRED in production.
#   Comma-separated explicit origins (a JSON array is also accepted).
#   "*" / "null" are rejected. Set your real frontend origin(s); the built-in
#   localhost defaults in config.py are for local dev only and must never be
#   relied on in prod. See docs/DEPLOYMENT.md.
CORS_ORIGINS=https://sellable.shop,https://www.sellable.shop

# Database / Supabase
#   Local dev can use SQLite. For the demo/production system of record, point
#   DATABASE_URL at a Supabase/Postgres instance (see docs/DATABASE.md).
DATABASE_URL=sqlite+pysqlite:///./data/sellable.db
# DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Password for the local docker-compose postgres service; docker-compose.yml
# reads it as ${POSTGRES_PASSWORD}. Use a generated secret outside local dev.
POSTGRES_PASSWORD=replace_me
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# LLM provider abstraction (any provider/model can be swapped via config)
# Example for OpenCode Zen (free contributor model):
#   LLM_PROVIDER=opencode
#   LLM_MODEL=mimo-v2.5-free
#   LLM_API_KEY=sk-... (OpenCode Zen key)
# Example for OpenRouter:
#   LLM_PROVIDER=openrouter
#   LLM_MODEL=openrouter/auto
#   OPENROUTER_API_KEY=sk-... (OpenRouter key, used ONLY when provider=openrouter)
#
# Which key is actually used depends on LLM_PROVIDER (see config.py):
#   opencode   -> LLM_API_KEY (an OpenCode Zen key)
#   openrouter -> OPENROUTER_API_KEY only (a Zen key sent to OpenRouter 401s)
#   openai / anthropic / google -> provider-specific key, else LLM_API_KEY fallback
#   mock       -> no key needed (default; keeps tests/evals offline)
# All of these are backend-only secrets and must never be exposed to the browser.
LLM_PROVIDER=mock
LLM_MODEL=
LLM_TEMPERATURE=0
# Generic fallback for any provider; for provider=opencode this is the OpenCode Zen key.
LLM_API_KEY=
# Provider-specific keys (backend-only secrets, never exposed to the browser)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# Razorpay — test-mode credentials only
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Agent authentication (server-side secrets)
#   Comma-separated list of SHA-256 hex hashes of the long-lived API keys that
#   buyers present. The plaintext key is never stored.
BUYER_AGENT_API_KEY_HASH=
BUYER_AGENT_HMAC_SECRET=

# zrok v2 uses an enable token to create a public share.
ZROK_ENABLE_TOKEN=replace_me

# ---------------------------------------------------------------------------
# Frontend (merchant console) — reference only. These variables live in
# apps/merchant-console/.env.local (see .env.local.example there), NOT in this
# file, and are baked into client-side JS at build time.
#   NEXT_PUBLIC_API_URL=https://api.sellable.shop   # this backend's base URL
#   NEXT_PUBLIC_SITE_URL=https://sellable.shop
#   NEXT_PUBLIC_AGENT_KEY=sellable_demo_key_001     # well-known PUBLIC demo key
#   NEXT_PUBLIC_SUPABASE_URL= / NEXT_PUBLIC_SUPABASE_ANON_KEY=  # unset = demo mode
#   NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...        # publishable key id only
# NEVER put real keys in NEXT_PUBLIC_*: anything with that prefix ships to the
# browser. Build a separate image per environment — a demo-built bundle keeps
# sending the demo key even when pointed at a production backend at runtime.
# ---------------------------------------------------------------------------
