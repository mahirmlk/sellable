# =============================================================================
# SELLABLE — environment configuration
# Copy to `.env` and fill in real values. Never commit the populated `.env`.
# =============================================================================

# Application
SELLABLE_ENVIRONMENT=development
API_BASE_URL=http://localhost:8000

# Database / Supabase
#   Local dev can use SQLite. For the demo/production system of record, point
#   DATABASE_URL at a Supabase/Postgres instance (see docs/DATABASE.md).
DATABASE_URL=sqlite+pysqlite:///./data/sellable.db
# DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# LLM provider abstraction (any provider/model can be swapped via config)
# Example for OpenCode Zen (free contributor model):
#   LLM_PROVIDER=opencode
#   LLM_MODEL=mimo-v2.5-free
#   LLM_API_KEY=sk-... (OpenCode Zen key)
# Example for OpenRouter:
#   LLM_PROVIDER=openrouter
#   LLM_MODEL=openrouter/auto
#   OPENROUTER_API_KEY=sk-... (OpenRouter key, used ONLY when provider=openrouter)
LLM_PROVIDER=mock
LLM_MODEL=
LLM_TEMPERATURE=0
# Generic fallback for any provider; for provider=opencode this is the OpenCode Zen key.
LLM_API_KEY=
# Provider-specific keys (backend-only secrets, never exposed to the browser)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# Razorpay — test-mode credentials only
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Agent authentication (server-side secrets)
#   Comma-separated list of SHA-256 hex hashes of the long-lived API keys that
#   buyers present. The plaintext key is never stored.
BUYER_AGENT_API_KEY_HASH=
BUYER_AGENT_HMAC_SECRET=

# zrok v2 uses an enable token to create a public share.
ZROK_ENABLE_TOKEN=replace_me
